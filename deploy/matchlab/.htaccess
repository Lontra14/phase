# Rogue Forge MatchLab — Apache / LiteSpeed (shared hosting) rules.
# Upload the whole site folder to the document root of a (sub)domain, e.g. mtg.tuodominio.it.

Options -Indexes
DirectoryIndex index.html

# The game engine is WebAssembly: browsers refuse it without the right type.
AddType application/wasm .wasm
AddType application/manifest+json .webmanifest
AddType application/json .json

# Single-page app: /lab, /game/<id>, /multiplayer ... are routes, not files.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
# Fallback if mod_rewrite is off: still land on the app.
ErrorDocument 404 /index.html

# The card database is large JSON: compress it on the fly.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/wasm image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change: cache for a year.
  <FilesMatch "\.(js|css|wasm|woff2?|webp|png|jpg|svg|mp3|ogg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Entry points must refresh so a new upload is picked up immediately.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.json|turn\.json|config\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
